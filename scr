-- AvalonHub: Czysty skrypt bez żadnych zewnętrznych loadstringów

local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local SERVER_URL = "https://server-avalon-production.up.railway.app/verify"

-- Sprawdzanie klucza przez GET
local function verifyKey(inputKey)
    if not inputKey or inputKey == "" then return false, "Klucz jest pusty" end
    local success, response = pcall(function()
        return game:HttpGet(SERVER_URL .. "?key=" .. HttpService:UrlEncode(inputKey))
    end)
    if success and response then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(response) end)
        if ok and decoded then
            return decoded.success, decoded.message or "Błąd odpowiedzi"
        end
    end
    return false, "Błąd połączenia z serwerem."
end

