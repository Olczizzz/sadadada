local SERVER_URL = "https://server-avalon-production.up.railway.app/verify"
local WORK_INK_LINK = "https://work.ink/2YQZ/c4917cd4-6a61-4a54-b6d7-1819f485b538"
local DISCORD_LINK = "discord.gg/avalonmarket"

local function verifyKeyWithBackend(inputKey)
    if not inputKey or inputKey == "" then return false, "Klucz jest pusty" end
    
    local targetUrl = SERVER_URL .. "?key=" .. HttpService:UrlEncode(inputKey)
    local success, response = pcall(function()
        return game:HttpGet(targetUrl)
    end)
    
    if success and response then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        
        if decodeSuccess and decoded then
            if decoded.success then
                return true, decoded.message
            else
                return false, decoded.message or "Klucz odrzucony przez serwer."
            end
        end
    end
    
    return false, "Błąd połączenia z serwerem autoryzacji."
end

